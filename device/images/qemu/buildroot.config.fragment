# ThoxOS Core - Buildroot config fragment - class qemu
# STAGING FRAGMENT: this is NOT a complete, built image configuration.
# Virtual lab target: runs the same ThoxOS Core userspace under QEMU
# (aarch64 virt machine) for CI, the virtual device lab, and pre-hardware
# qualification. No physical-device claims are made from qemu runs.
#
# Class profile: virtual quad-core Arm (64-bit), 2 GB RAM default.

# --- Target architecture ---
BR2_aarch64=y
BR2_cortex_a53=y

# --- Toolchain (external, pinned, reproducible) ---
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_OPTIMIZE_S=y

# --- Kernel (linux-thox LTS, virt-friendly config) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/thox/qemu/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# --- Init / system ---
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="thox-qemu"
BR2_SYSTEM_DHCP="systemd-networkd"

# --- Filesystem: same squashfs rootfs as device classes; slots emulated ---
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_EXT2=y

# --- THOX packages: identical Core selections to e2 so CI exercises the
#     same unit set, plus lab-only serial console access. ---
# BR2_PACKAGE_THOXD=y
# BR2_PACKAGE_THOXOS_PORTAL=y
# BR2_PACKAGE_MESHSTACK_LOCAL=y
# BR2_PACKAGE_THOX_ENTITLEMENT_AGENT=y
# BR2_PACKAGE_THOK_KVD=y
# BR2_PACKAGE_RAUC=y
# BR2_PACKAGE_WIREGUARD_TOOLS=y
# BR2_PACKAGE_SYSTEMD_NETWORKD=y
# BR2_PACKAGE_OPENSSH=y
