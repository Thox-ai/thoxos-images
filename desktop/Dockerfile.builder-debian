# ThoxOS Desktop Edition: Debian builder image.
# Debian 13 (trixie) pinned by digest (debian:trixie as pulled 2026-10-25)
# with mkosi 27.1 from the upstream GitHub release tarball (trixie ships
# mkosi 25.3; the pipeline standard is the 27 series, same as the Arch
# builder; PyPI is not reachable from this build network, GitHub is), the
# layout tooling
# (systemd-repart, mkfs), the UKI tooling for the host side, and the theme
# render tools (rsvg for wallpapers and Plymouth assets, xcursorgen for the
# TXF cursor theme).
FROM debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
ENV DEBIAN_FRONTEND=noninteractive
RUN printf '%s\n' \
      'Types: deb' \
      'URIs: http://deb.debian.org/debian' \
      'Suites: trixie trixie-updates' \
      'Components: main contrib non-free non-free-firmware' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/debian.sources \
 && rm -f /etc/apt/sources.list \
 && apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      systemd systemd-container systemd-ukify systemd-repart \
      btrfs-progs dosfstools mtools e2fsprogs gdisk util-linux \
      zstd rsync git python3 python3-pip python3-pefile python3-setuptools jq zip unzip \
      cpio cryptsetup curl ca-certificates gnupg apt apt-utils gpgv \
      debian-archive-keyring librsvg2-bin x11-apps file \
 && curl -fsSL https://github.com/systemd/mkosi/archive/refs/tags/v27.1.tar.gz -o /tmp/mkosi.tgz \
 && pip install --break-system-packages --no-build-isolation --no-cache-dir /tmp/mkosi.tgz \
 && rm -f /tmp/mkosi.tgz \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && mkosi --version
ENV CARGO_HOME=/cache/cargo/home RUSTUP_HOME=/cache/cargo/rustup
WORKDIR /work
